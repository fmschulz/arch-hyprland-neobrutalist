{
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "paths": {
      "ags": ["./.types/sdk/lib/index.d.ts"],
      "ags/*": ["./.types/sdk/lib/*"],
      "gnim": ["./.types/sdk/node_modules/gnim/dist/index.d.ts"],
      "gnim/*": ["./.types/sdk/node_modules/gnim/dist/*"]
    },
    "skipLibCheck": true,
    "experimentalDecorators": false
  },
  "include": ["*.ts", "*.tsx", "tests/**/*.ts", "tests/**/*.tsx", ".types/**/*.d.ts"]
}
