{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window", "hyprland/submap"],
    "modules-center": ["custom/clock"],
    "modules-right": ["network", "battery", "pulseaudio", "backlight", "bluetooth", "idle_inhibitor", "tray", "custom/system-stats", "custom/updates", "custom/usb", "custom/workspace-overview", "custom/power"],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "sort-by": "id",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50
    },

    "hyprland/submap": {
        "format": "MODE: {}",
        "max-length": 24,
        "tooltip": false
    },

    "custom/clock": {
        "exec": "~/.config/scripts/clock-waybar.sh",
        "return-type": "json",
        "interval": 30,
        "tooltip": true,
        "on-click": "~/.config/scripts/calendar-open.sh",
        "on-click-right": "~/.config/scripts/calendar-open.sh --year"
    },

    "custom/system-stats": {
        "exec": "~/.config/scripts/system-stats-waybar.sh",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "on-click": "kitty -e htop",
        "on-click-right": "kitty -e ncdu /home"
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Wi-Fi disconnected",
        "on-click": "~/.config/scripts/wifi-menu.sh"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": {
            "default": ["󰁺", "󰁻", "󰁾", "󰂁", "󰁹"],
            "charging": ["󰂄"],
            "plugged": ["󰚥"],
            "warning": ["󰂃"],
            "critical": ["󰂃"]
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰒲"
        },
        "tooltip-format-activated": "Idle inhibitor: ON (won't sleep)",
        "tooltip-format-deactivated": "Idle inhibitor: OFF"
    },

    "custom/updates": {
        "exec": "~/.config/scripts/updates-waybar.sh",
        "return-type": "json",
        "interval": 3600,
        "signal": 9,
        "on-click": "kitty -e bash -c 'sudo pacman -Syu; pkill -RTMIN+9 waybar; echo; echo Press any key to close...; read -n1'",
        "tooltip": true
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip-format": "Brightness: {percent}%"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} 󰂰 {volume}%",
        "format-bluetooth-muted": "󰝟 󰂰",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/workspace-overview": {
        "exec": "~/.config/scripts/workspace-rename.sh waybar",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "on-click": "~/.config/scripts/workspace-rename.sh overview",
        "signal": 8
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": "Sleep / Reboot / Shutdown",
        "on-click": "~/.config/scripts/power-menu.sh"
    },
    "custom/usb": {
        "format": "{}",
        "exec": "~/.config/scripts/usb-monitor.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/scripts/usb-menu.sh",
        "tooltip": true
    }
}
